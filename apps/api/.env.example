# Copy to apps/api/.env for `pnpm --filter @proctor/api dev`. Matches infra/docker-compose.yml.
# These are local dev-only values. Never put real keys or passwords in this file: it is
# committed to git. Real values go in apps/api/.env (git-ignored) or in Vercel's settings.
DATABASE_URL=postgres://proctor:proctor@localhost:5432/proctor
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=evidence
S3_ACCESS_KEY=proctor-minio
S3_SECRET_KEY=proctor-minio-secret
PORT=4000
CORS_ORIGINS=http://localhost:5173

# Production (see docs/DEPLOYMENT.md). Uncomment in apps/api/.env and fill in your own values.
# DATABASE_URL=postgres://<user>:<password>@<host>/<database>?sslmode=require
# DB_PREPARE=false
# S3_ENDPOINT=https://s3.<region>.backblazeb2.com
# S3_REGION=<region>
# S3_BUCKET=<bucket-name>
# S3_ACCESS_KEY=<key-id>
# S3_SECRET_KEY=<application-key>
# CRON_SECRET=<random string, at least 16 characters; enables the retention route>
