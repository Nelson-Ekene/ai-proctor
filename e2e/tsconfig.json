{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "node_modules/.tmp/tsconfig",
    "lib": ["ES2023", "DOM"],
    "types": ["node", "chrome"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "*.ts",
    "tests/**/*.ts",
    "dashboard/**/*.ts",
    "fullstack/**/*.ts",
    "fairness/**/*.ts"
  ],
  "references": [{ "path": "../packages/core" }]
}
